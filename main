"""beginner blackjack game utilizing OOP principles"""

import random


BLACKJACK = "Blackjack!!"
BUST = "Bust!"
DEALER = "Dealer"
ACE = "Ace"
SUITS = {"Heart", "Diamond", "Spade", "Club"}
VALUES = {
    ACE: 11,
    "King": 10,
    "Queen": 10,
    "Jack": 10,
    "Ten": 10,
    "Nine": 9,
    "Eight": 8,
    "Seven": 7,
    "Six": 6,
    "Five": 5,
    "Four": 4,
    "Three": 3,
    "Two": 2,
}
ACTIONS = {"h": "hit", "s": "stand"}
HIT = "h"
STAND = "s"
NEW_GAME_CHOICES = {"y": "yes", "n": "no"}
YES = "y"
NO = "n"
MAX_PLAYERS = 4


# ==========================
# UTILITY
# ==========================

def get_valid_response(valid_choices: set, prompt: str, case=str.lower) -> str:
    while True:
        response = case(input(prompt).strip())
        if response not in valid_choices:
            print("Invalid Input.")
        else:
            return response


def get_unique_alpha_response(invalid_choices: set, prompt: str, case=str.lower) -> str:
    unique_error_msg = "Already Taken."
    alpha_error_msg = "Must be alphabetical only. No numbers or special chars."
    while True:
        response = case(input(prompt).strip())
        if not response.isalpha():
            print(alpha_error_msg)
        elif response in invalid_choices:
            print(unique_error_msg)
        else:
            return response


def construct_prompt_ending(keys: list[str]) -> str:
    keys_with_brackets = [
        f"[{i[0].upper()}]{i[1:]}" if len(i) > 1 else f"[{i.upper()}]" for i in keys
    ]
    main_text = ", ".join(keys_with_brackets[:-1])
    if len(keys_with_brackets) == 2:
        main_text = main_text + " or"
    elif len(keys_with_brackets) > 2:
        main_text = main_text + ", or"
    prompt_end = f"{main_text} {keys_with_brackets[-1]}?: "
    return prompt_end


def construct_prompt_and_keys(selection: int | dict) -> tuple[str, set[str]]:
    if isinstance(selection, int):
        valid_input_list = [str(i) for i in range(1, selection + 1)]
        prompt_end = construct_prompt_ending(valid_input_list)
        valid_keys = set(valid_input_list)
        return prompt_end, valid_keys
    else:
        valid_input_list = [v for v in selection.values()]
        prompt_end = construct_prompt_ending(valid_input_list)
        valid_keys = set(i[0].lower() for i in valid_input_list)
        return prompt_end, valid_keys


# ==========================
# GAME SETUP
# ==========================


def play_new_game_choice() -> bool:
    prompt_start = "\nNew game?"
    prompt_end, valid_keys = construct_prompt_and_keys(NEW_GAME_CHOICES)

    response = get_valid_response(valid_keys, f"{prompt_start} {prompt_end}")

    if response == YES:
        return True
    else:
        return False


def get_players() -> int:
    prompt_start = f"\nHow many players are playing against me ({DEALER})?"
    prompt_end, valid_keys = construct_prompt_and_keys(MAX_PLAYERS)

    response = int(get_valid_response(valid_keys, f"{prompt_start} {prompt_end}"))
    return response


def collect_player_names(players: int) -> list[str]:
    player_sheet = []
    name_set = set()
    for p in range(1, players + 1):
        name = get_unique_alpha_response(
            name_set, f"\nWhat is Player {p}'s name?: ", str.title
        )
        player_sheet.append(name)
        name_set.add(name)

    return player_sheet


# ==========================
# GAME CLASSES
# ==========================

class Card:
    def __init__(self, suit: str, rank: str):
        self.suit = suit
        self.rank = rank
        self.value = VALUES[rank]
        self.name = f"{rank} of {suit}s"


class Deck:
    def __init__(self):
        self.cards = [Card(suit, rank) for suit in SUITS for rank in VALUES]
        self.discards = []

    def shuffle(self) -> None:
        self.cards.extend(self.discards)
        random.shuffle(self.cards)

    def release_card(self) -> Card:
        card = self.cards.pop()
        self.discards.append(card)
        return card

    def receive_cards(self, cards: list[Card]) -> None:
        self.discards.extend(cards)


class Hand:
    def __init__(self):
        self.cards = []

    def add_card(self, card: Card) -> None:
        self.cards.append(card)

    def calculate_hand_total(self) -> int:
        total = sum([card.value for card in self.cards])
        aces = sum([1 for card in self.cards if card.rank == ACE])

        while total > 21 and aces > 0:
            total -= 10
            aces -= 1

        return total

    def return_cards(self) -> list[Card]:
        discards = [card for card in self.cards]
        self.cards.clear()
        return discards


class Player:
    def __init__(self, name: str) -> None:
        self.name = name
        self.hand = Hand()

    def hit(self, card: Card) -> None:
        self.hand.add_card(card)

    def stand(self) -> None:
        pass

    def show_hand(self) -> None:
        print(
            f"\n{self.name}'s Hand: {', '.join(card.name for card in self.hand.cards)} ({self.hand.calculate_hand_total()})"
        )

    def check_if_bust(self) -> bool:
        if self.hand.calculate_hand_total() > 21:
            return True
        else:
            return False

    def check_if_natrual_blackjack(self) -> bool:
        if self.hand.calculate_hand_total() == 21 and len(self.hand.cards) == 2:
            return True
        else:
            return False


class Dealer(Player):
    def __init__(self):
        super().__init__(DEALER)

    def show_first_card(self) -> None:
        print(
            f"\n{self.name}'s Face up Card: {self.hand.cards[0].name} ({self.hand.cards[0].value})"
        )

    def check_if_must_hit(self) -> bool:
        if self.hand.calculate_hand_total() >= 17:
            return False
        else:
            return True


class Game:
    def __init__(self, player_names: list[str]):
        self.deck = Deck()
        self.dealer = Dealer()
        self.player_list = [Player(player) for player in player_names]

    def deal_initial_cards(self) -> None:
        for i in range(0, 2):
            self.dealer.hand.add_card(self.deck.release_card())
        for player in self.player_list:
            for i in range(0, 2):
                player.hand.add_card(self.deck.release_card())

    def show_initial_cards(self) -> None:
        self.dealer.show_first_card()
        displayed_value = self.dealer.hand.cards[0].value
        if displayed_value == 11:
            print(f"\nFlipping {DEALER}'s second card...")
            self.dealer.show_hand()
        if self.dealer.check_if_natrual_blackjack():
            print(f"    {DEALER}'s got a {BLACKJACK}")
        for player in self.player_list:
            player.show_hand()
            if player.check_if_natrual_blackjack():
                print(f"    {player.name}'s got a {BLACKJACK}")

    def get_player_action(self, player: Player) -> str:
        prompt_end = construct_prompt_ending([v for v in ACTIONS.values()])
        prompt_start = f"\nWhat would you like to do, {player.name}? "
        prompt = prompt_start + prompt_end
        action = get_valid_response({k for k in ACTIONS}, prompt)
        return action

    def perform_player_turn(self, player: Player) -> None:
        if self.dealer.check_if_natrual_blackjack() or player.check_if_natrual_blackjack():
            return None
        while True:
            if player.check_if_bust():
                print(f"\n{BUST} for {player.name}...")
                break
            elif player.hand.calculate_hand_total() == 21:
                print(f"\n{BLACKJACK} for {player.name}!!!")
                break
            else:
                action = self.get_player_action(player)
                if action == HIT:
                    player.hit(self.deck.release_card())
                    player.show_hand()
                else:
                    player.stand()
                    break

    def player_turns(self) -> None:
        for player in self.player_list:
            self.perform_player_turn(player)

    def dealer_turn(self) -> None:
        if self.dealer.check_if_natrual_blackjack():
            return None
        self.dealer.show_hand()
        for player in self.player_list:
            if player.check_if_natrual_blackjack():
                continue
            while True:
                if self.dealer.check_if_bust():
                    break
                elif self.dealer.hand.calculate_hand_total() == 21:
                    break
                elif self.dealer.check_if_must_hit():
                    self.dealer.hit(self.deck.release_card())
                    self.dealer.show_hand()
                else:
                    break
        if self.dealer.check_if_bust():
            print(f"\n{DEALER} {BUST}")
        elif self.dealer.hand.calculate_hand_total() == 21:
            print(f"\n{DEALER} {BLACKJACK}")

    def determine_winners(self) -> None:
        print("\nRound Results:")
        dealer_bust = self.dealer.check_if_bust()
        dealer_total = self.dealer.hand.calculate_hand_total()
        dealer_natrual_blackjack = self.dealer.check_if_natrual_blackjack()
        for player in self.player_list:
            prompt_start = f"    {player.name} v {DEALER} result:"
            player_bust = player.check_if_bust()
            player_total = player.hand.calculate_hand_total()
            player_natrual_blackjack = player.check_if_natrual_blackjack()
            if dealer_natrual_blackjack and player_natrual_blackjack:
                print(f"{prompt_start} Push")
            elif player_natrual_blackjack and not dealer_natrual_blackjack:
                print(f"{prompt_start} {player.name} Wins with a Natrual Blackjack!!")
            elif dealer_natrual_blackjack and not player_natrual_blackjack:
                print(f"{prompt_start} {DEALER} wins with a Natrual Blackjack...")
            elif player_bust and dealer_bust or player_total == dealer_total:
                print(f"{prompt_start} Push")
            elif dealer_bust:
                print(f"{prompt_start} {player.name} Wins!!")
            elif player_bust:
                print(f"{prompt_start} {DEALER} wins...")
            elif player_total > dealer_total:
                print(f"{prompt_start} {player.name} Wins!!")
            else:
                print(f"{prompt_start} {DEALER} wins...")

    def discard_hands(self):
        for player in self.player_list:
            discards = player.hand.return_cards()
            self.deck.receive_cards(discards)
        discards = self.dealer.hand.return_cards()
        self.deck.receive_cards(discards)


# ==========================
# MAIN
# ==========================

def main():
    players = get_players()
    player_list = collect_player_names(players)
    game = Game(player_list)
    running = True
    while running:
        game.deck.shuffle()
        game.deal_initial_cards()
        game.show_initial_cards()
        game.player_turns()
        game.dealer_turn()
        game.determine_winners()
        game.discard_hands()
        if not play_new_game_choice():
            running = False


if __name__ == "__main__":
    main()
